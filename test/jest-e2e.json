{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../",
  "testMatch": ["**/test/**/*.e2e-spec.ts"],
  "transform": {
    "^.+\\.(t|j)s?$": ["@swc/jest"]
  },
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "globalSetup": "./test/helpers/global-setup.ts",
  "globalTeardown": "./test/helpers/global-teardown.ts",
  "modulePaths": ["<rootDir>"],
  "testTimeout": 30000
}