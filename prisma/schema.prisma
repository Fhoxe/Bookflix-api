generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────

enum ReadingStatus {
  TO_READ
  READING
  READ
}

// ─── Models ───────────────────────────────────────────────────────

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String   @unique
  password  String
  bio       String?
  avatar    String?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  collection UserBook[]
  reviews    Review[]

  @@map("users")
}

model Book {
  id            String   @id @default(uuid())
  googleBooksId String?  @unique
  title         String
  authors       String   @default("")
  description   String?
  publishedYear Int?
  genre         String?
  coverUrl      String?
  isbn          String?  @unique
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  collection UserBook[]
  reviews    Review[]

  @@map("books")
}

model UserBook {
  id        String        @id @default(uuid())
  status    ReadingStatus @default(TO_READ)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  userId String
  bookId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("user_books")
}

model Review {
  id        String   @id @default(uuid())
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  bookId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@map("reviews")
}